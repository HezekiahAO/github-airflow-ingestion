# Copy to .env and fill in. Never commit .env.

# --- GitHub ---------------------------------------------------------------
# Fine-grained or classic token; public repo metadata needs no extra scopes.
GITHUB_TOKEN=
GITHUB_ORGS=stripe,shopify,microsoft

# --- Airflow ----------------------------------------------------------------
# On Linux set this to the output of `id -u` so files in ./logs and ./data are yours.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# --- Postgres -----------------------------------------------------------------
# Airflow's own metadata database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
# Pipeline data database (github_repos, quarantine, pipeline_runs, ...)
GITHUB_DB_USER=github
GITHUB_DB_PASSWORD=change-me
GITHUB_DB_NAME=github_data
